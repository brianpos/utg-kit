@page "/"
@layout UtgKit.Web.Components.Layout.SimulatorLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject UtgKit.Core.Services.ThoFileService ThoFileService
@implements IDisposable

<PageTitle>HL7 Terminology (THO) — Local Simulation</PageTitle>

<p>
    This is a local simulation of <a href="https://terminology.hl7.org" target="_blank">terminology.hl7.org</a>,
    powered by UTG Kit. Browse Code Systems, Value Sets, and other terminology
    artifacts from your local THO repository clone.
</p>
<p>
    It is <strong>NOT</strong> a replacement of UTG or the formal build process.
</p>

@if (loadingProgress is not null && !indexReady)
{
    <div class="loading-progress">
        <p><em>Indexing THO repository…</em></p>
        <progress max="@loadingProgress.TotalFiles" value="@loadingProgress.ProcessedFiles"></progress>
        <p>@loadingProgress.ProcessedFiles of @loadingProgress.TotalFiles files processed</p>
    </div>
}
else if (indexReady)
{
    <p>✔ Resource index ready.</p>
}

<h3>Quick Actions</h3>
<ul>
    <li><a href="/codesystems/import">Import a CodeSystem</a></li>
    <li><a href="/valuesets/import">Import a ValueSet</a></li>
</ul>

<ParsingErrors />

@code {
    private UtgKit.Core.Services.IndexingProgress? loadingProgress;
    private bool indexReady;

    protected override async Task OnInitializedAsync()
    {
        loadingProgress = ThoFileService.CurrentIndexingProgress;
        ThoFileService.IndexingProgressChanged += OnProgressChanged;

        await ThoFileService.GetCodeSystemIndexAsync();
        indexReady = true;
    }

    private void OnProgressChanged(UtgKit.Core.Services.IndexingProgress progress)
    {
        loadingProgress = progress;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThoFileService.IndexingProgressChanged -= OnProgressChanged;
    }
}
