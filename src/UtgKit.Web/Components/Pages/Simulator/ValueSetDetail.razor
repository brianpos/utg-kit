@page "/ValueSet-{Id}.html"
@layout UtgKit.Web.Components.Layout.SimulatorLayout
@rendermode InteractiveServer
@using Hl7.Fhir.Model
@inject UtgKit.Core.Services.ThoFileService ThoFileService
@inject UtgKit.Core.Services.ValueSetExpansionService ExpansionService
@implements IDisposable

<PageTitle>@(valueSet?.Title ?? valueSet?.Name ?? Id) — HL7 Terminology (THO)</PageTitle>

@if (valueSet is null)
{
    <div class="tho-alert">
        <h2>ValueSet Not Found</h2>
        <p>No ValueSet with id "<strong>@Id</strong>" was found in the local THO repository.</p>
    </div>
}
else
{
    <nav class="tho-breadcrumb">
        <a href="/">Home</a> &rsaquo;
        <a href="/valuesets">Value Sets</a> &rsaquo;
        <span>@(valueSet.Title ?? valueSet.Name)</span>
    </nav>

    <div class="tho-tab-bar">
        <button class="tho-tab @(activeTab == Tab.Narrative ? "active" : "")" @onclick="() => activeTab = Tab.Narrative">Narrative Content</button>
        <button class="tho-tab @(activeTab == Tab.Xml ? "active" : "")" @onclick="() => activeTab = Tab.Xml">XML</button>
        <button class="tho-tab @(activeTab == Tab.Json ? "active" : "")" @onclick="() => activeTab = Tab.Json">JSON</button>
    </div>

    @if (activeTab == Tab.Xml)
    {
        <CodeBlock Code="@(xmlContent!)" Language="xml" />
    }
    else if (activeTab == Tab.Json)
    {
        <CodeBlock Code="@(jsonContent!)" Language="json" />
    }
    else
    {

    <h2>ValueSet: @(valueSet.Title ?? valueSet.Name)</h2>

    <table class="tho-metadata">
        <tr>
            <td colspan="3"><i>Official URL:</i> <strong>@valueSet.Url</strong></td>
            <td colspan="1"><i>Version:</i> <strong>@valueSet.Version</strong></td>
        </tr>
        <tr>
            @if (valueSet.Status.HasValue)
            {
                <td><strong>@valueSet.Status</strong> as of @(valueSet.Date ?? "unknown")</td>
            }
            @if (fmm is not null)
            {
                <td>
                    <a href="http://hl7.org/fhir/versions.html#maturity" target="_blank">Maturity Level</a>: @fmm
                </td>
            }
            @if (!string.IsNullOrEmpty(valueSet.Publisher))
            {
                <td><i>Responsible:</i> @valueSet.Publisher</td>
            }
            @if (!string.IsNullOrEmpty(valueSet.Name))
            {
                <td><i>Computable Name:</i> @valueSet.Name</td>
            }
        </tr>
    </table>

    <div class="tho-manifest-groups">
        <strong>Manifest groups:</strong>
        @if (resourceGroups.Count > 0)
        {
            @foreach (var group in resourceGroups)
            {
                <span class="tho-group-badge">@group<button class="tho-group-remove" @onclick="() => RemoveFromGroup(group)" title="Remove from @group">&times;</button></span>
            }
        }
        else
        {
            <span class="tho-group-badge unallocated">Un-allocated</span>
        }
        @if (availableGroups.Count > 0)
        {
            <select @bind="selectedGroup">
                <option value="">Add to group…</option>
                @foreach (var group in availableGroups)
                {
                    <option value="@group">@group</option>
                }
            </select>
            <button class="tho-btn-small" @onclick="AddToGroup" disabled="@string.IsNullOrEmpty(selectedGroup)">Add</button>
        }
    </div>

    @if (!string.IsNullOrEmpty(valueSet.Copyright))
    {
        <div class="tho-copyright">
            <strong>Copyright/Legal:</strong> @valueSet.Copyright
        </div>
    }

    @if (!string.IsNullOrEmpty(valueSet.Description?.ToString()))
    {
        <p>@valueSet.Description</p>
    }

    @if (!string.IsNullOrEmpty(valueSet.Purpose))
    {
        <p>@valueSet.Purpose</p>
    }

    <div class="tho-details">
        @if (valueSet.Meta?.LastUpdated.HasValue == true)
        {
            <p>Last updated: @valueSet.Meta.LastUpdated</p>
        }
        <p>
            This value set <code>@valueSet.Url</code>
            @if (valueSet.Immutable == true)
            {
                <text> is immutable and</text>
            }
            @if (valueSet.Compose?.Include?.Count > 0)
            {
                <text> includes codes from @valueSet.Compose.Include.Count code system(s).</text>
            }
        </p>
    </div>

    @if (valueSet.Compose?.Include?.Count > 0)
    {
        @foreach (var include in valueSet.Compose.Include)
        {
            <h3>From <code>@if (include.System is not null && codeSystemIds.TryGetValue(include.System, out var csId))
                    {<a href="/CodeSystem-@(csId).html">@include.System</a>}
                    else
                    {@include.System}</code></h3>

            @if (include.Concept?.Count > 0)
            {
                <table class="tho-concept-table">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Display</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var concept in include.Concept)
                        {
                            <tr>
                                <td><code>@concept.Code</code></td>
                                <td>@concept.Display</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (include.Filter?.Count > 0)
            {
                <p>Filtered by:</p>
                <ul>
                    @foreach (var filter in include.Filter)
                    {
                        <li><code>@filter.Property</code> @filter.Op <code>@filter.Value</code></li>
                    }
                </ul>
            }
            else
            {
                <p>All codes from this system are included.</p>
            }
        }
    }

    @if (valueSet.Expansion?.Contains?.Count > 0)
    {
        <h3>Expansion@(wasExpanded ? " (generated)" : "")</h3>
        <table class="tho-concept-table">
            <thead>
                <tr>
                    <th>System</th>
                    <th>Code</th>
                    <th>Display</th>
                    <th>Definition</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in valueSet.Expansion.Contains)
                {
                    <tr>
                        <td>@if (item.System is not null && codeSystemIds.TryGetValue(item.System, out var expCsId))
                            {<a href="/CodeSystem-@(expCsId).html">@item.System</a>}
                            else
                            {@item.System}</td>
                        <td><code>@item.Code</code></td>
                        <td>@item.Display</td>
                        <td>@GetConceptDefinition(item)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <ResourceHistory ResourceReference="@($"ValueSet/{Id}")" />

    } @* end Narrative tab *@
}

@code {
    [Parameter]
    public string Id { get; set; } = default!;

    private ValueSet? valueSet;
    private string? fmm;
    private bool wasExpanded;
    private Tab activeTab = Tab.Narrative;
    private string? xmlContent;
    private string? jsonContent;
    private Dictionary<string, string> codeSystemIds = new();
    private Dictionary<string, CodeSystem?> loadedCodeSystems = new(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<string> resourceGroups = [];
    private IReadOnlyList<string> availableGroups = [];
    private string selectedGroup = "";

    private enum Tab { Narrative, Xml, Json }

    private static IEnumerable<string> CollectSystemUrls(ValueSet vs)
    {
        if (vs.Compose?.Include is not null)
            foreach (var inc in vs.Compose.Include)
                if (inc.System is not null) yield return inc.System;
        if (vs.Expansion?.Contains is not null)
            foreach (var c in vs.Expansion.Contains)
                if (c.System is not null) yield return c.System;
    }

    protected override void OnParametersSet()
    {
        ThoFileService.IndexChanged -= OnIndexChanged;
        ThoFileService.IndexChanged += OnIndexChanged;
        LoadData();
    }

    private void LoadData()
    {
        loadedCodeSystems.Clear();
        valueSet = ThoFileService.LoadValueSet(Id);

        fmm = valueSet?.Extension
            ?.FirstOrDefault(e => e.Url == "http://hl7.org/fhir/StructureDefinition/structuredefinition-fmm")
            ?.Value?.ToString();

        if (valueSet is not null)
        {
            // Serialize first so XML/JSON tabs reflect original on-disk content.
            xmlContent = ThoFileService.SerializeToXml(valueSet);
            jsonContent = ThoFileService.SerializeToJson(valueSet);

            // If the ValueSet has no expansion, try to expand it using local CodeSystems.
            // This only affects the Narrative tab rendering.
            wasExpanded = valueSet.Expansion?.Contains?.Count is null or 0
                && ExpansionService.TryExpand(valueSet);

            // Build a lookup of CodeSystem canonical URLs to local IDs for navigation links.
            codeSystemIds = CollectSystemUrls(valueSet)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Select(url => (url, entry: ThoFileService.GetCodeSystemIndexEntryByUrl(url)))
                .Where(t => t.entry is not null)
                .ToDictionary(t => t.url, t => t.entry!.Id, StringComparer.OrdinalIgnoreCase);
        }

        LoadManifestGroupInfo();
    }

    private void OnIndexChanged()
    {
        InvokeAsync(() =>
        {
            LoadData();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ThoFileService.IndexChanged -= OnIndexChanged;
    }

    private void LoadManifestGroupInfo()
    {
        var reference = $"ValueSet/{Id}";
        resourceGroups = ThoFileService.GetManifestGroupsForResource(reference);
        var allGroups = ThoFileService.GetManifestGroups();
        availableGroups = allGroups.Where(g => !resourceGroups.Contains(g)).ToList();
    }

    private void AddToGroup()
    {
        if (string.IsNullOrEmpty(selectedGroup)) return;
        ThoFileService.AddResourceToManifestGroup(selectedGroup, $"ValueSet/{Id}", "ValueSet");
        selectedGroup = "";
        LoadManifestGroupInfo();
    }

    private void RemoveFromGroup(string group)
    {
        ThoFileService.RemoveResourceFromManifestGroup(group, $"ValueSet/{Id}");
        LoadManifestGroupInfo();
    }

    private string? GetConceptDefinition(ValueSet.ContainsComponent item)
    {
        var extDef = item.GetExtensionValue<FhirString>(
            "http://hl7.org/fhir/StructureDefinition/valueset-concept-definition")?.Value;
        if (!string.IsNullOrEmpty(extDef))
            return extDef;

        if (item.System is null || item.Code is null)
            return null;

        if (!loadedCodeSystems.TryGetValue(item.System, out var cs))
        {
            cs = ThoFileService.LoadCodeSystemByUrl(item.System);
            loadedCodeSystems[item.System] = cs;
        }

        return cs is not null ? FindDefinition(cs.Concept, item.Code) : null;
    }

    private static string? FindDefinition(List<CodeSystem.ConceptDefinitionComponent>? concepts, string code)
    {
        if (concepts is null) return null;
        foreach (var c in concepts)
        {
            if (string.Equals(c.Code, code, StringComparison.OrdinalIgnoreCase))
                return c.Definition;
            var nested = FindDefinition(c.Concept, code);
            if (nested is not null) return nested;
        }
        return null;
    }
}
